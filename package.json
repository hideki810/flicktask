    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module"
}